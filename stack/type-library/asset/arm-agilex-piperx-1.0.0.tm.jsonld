      "instanceName": "controller"
    }
  ],
  "tm:optional": [
    "/properties/serialNumber",
    "/properties/parentId"
  ],
  "properties": {
    "vendor": {
      "type": "string",
      "default": "AgileX Robotics"
    },
    "model": {
      "type": "string",
      "default": "PiPER X"
    },
    "serialNumber": {
      "type": "string"
    },
    "kinematicModelUri": {
      "type": "string",
      "default": "https://github.com/google-deepmind/mujoco_menagerie/tree/main/agilex_piper"
    },
    "parentId": {
      "type": "string",
      "description": "Thing ID of the parent asset-group (ISA-95 hierarchy)."
    },
    "isa95Path": {
      "type": "string",
      "description": "Slash-separated ISA-95 path, e.g. lab/cell-1/panda-001."
    }
  }
}
