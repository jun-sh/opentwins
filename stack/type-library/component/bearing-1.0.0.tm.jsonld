{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    { "ditto": "https://ditto.eclipseprojects.io/wot/ditto-extension#" }
  ],
  "@type": "tm:ThingModel",
  "title": "Rolling Bearing",
  "description": "Rolling-element bearing monitored by casing vibration and temperature (pumps, fans, motors). Geometry is configuration for defect-frequency features (BPFO/BPFI/BSF/FTF).",
  "version": { "model": "1.0.0" },
  "links": [
    {
      "rel": "tm:extends",
      "href": "http://phm-models/models/base/monitored-component-1.0.0.tm.jsonld",
      "type": "application/tm+json"
    }
  ],
  "tm:optional": [
    "/properties/lastAssessedAt",
    "/properties/modelRef",
    "/events/conditionChanged",
    "/properties/vibrationPeak",
    "/properties/temperature",
    "/properties/designation",
    "/properties/rollingElements",
    "/properties/pitchDiameter",
    "/properties/rollingElementDiameter",
    "/properties/contactAngle"
  ],
  "properties": {
    "vibrationRms":           { "title": "Vibration velocity RMS (ISO 10816 / 20816)", "type": "number", "minimum": 0, "unit": "mm/s", "ditto:category": "status" },
    "vibrationPeak":          { "title": "Vibration velocity peak", "type": "number", "minimum": 0, "unit": "mm/s", "ditto:category": "status" },
    "temperature":            { "title": "Bearing housing temperature", "type": "number", "unit": "Cel", "ditto:category": "status" },
    "designation":            { "title": "Bearing designation (e.g. 6312)", "type": "string", "ditto:category": "configuration" },
    "rollingElements":        { "title": "Number of rolling elements", "type": "integer", "minimum": 1, "ditto:category": "configuration" },
    "pitchDiameter":          { "title": "Pitch diameter", "type": "number", "unit": "mm", "ditto:category": "configuration" },
    "rollingElementDiameter": { "title": "Rolling element diameter", "type": "number", "unit": "mm", "ditto:category": "configuration" },
    "contactAngle":           { "title": "Contact angle", "type": "number", "unit": "deg", "ditto:category": "configuration" }
  }
}
