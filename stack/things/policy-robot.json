{
  "entries": {
    "OWNER": {
      "subjects": { "nginx:${DITTO_USER}": { "type": "nginx basic auth user" } },
      "resources": {
        "thing:/":   { "grant": ["READ", "WRITE"], "revoke": [] },
        "policy:/":  { "grant": ["READ", "WRITE"], "revoke": [] },
        "message:/": { "grant": ["READ", "WRITE"], "revoke": [] }
      }
    },
    "INGEST": {
      "subjects": { "integration:phm-ingest": { "type": "Ditto MQTT connection phm-mqtt-ingest" } },
      "resources": {
        "thing:/features": { "grant": ["READ", "WRITE"], "revoke": [] }
      }
    }
  }
}
