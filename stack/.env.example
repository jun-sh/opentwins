# Copied to .env by scripts/init-env.sh, which fills every empty secret with a random value.
COMPOSE_PROJECT_NAME=phm
DITTO_VERSION=3.9.9

# Host bindings. MQTT listens on all interfaces so edge PCs next to the robots can publish.
PHM_BIND=127.0.0.1
PHM_MQTT_BIND=0.0.0.0
PHM_HTTP_PORT=18080
PHM_MQTT_PORT=11883
PHM_INFLUX_PORT=18086
PHM_GRAFANA_PORT=13000

# 0 = keep raw data forever
INFLUX_RAW_RETENTION=0

# Login for the Ditto UI/API (nginx basic auth; Ditto subject nginx:<user>). Grafana admin user is always "admin".
DITTO_USER=admin

# Secrets (generated when empty)
DITTO_USER_PASSWORD=
DITTO_DEVOPS_PASSWORD=
INFLUX_ADMIN_PASSWORD=
INFLUX_TOKEN=
GRAFANA_ADMIN_PASSWORD=
MQTT_EDGE_PASSWORD=
MQTT_DITTO_PASSWORD=
MQTT_TELEGRAF_PASSWORD=
